# Copy this file to .env and put real values there. .env is ignored by Git.
# Never put a real key in this file: it is committed.

# LLM provider: "gemini" or "ollama"
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me
OLLAMA_BASE_URL=http://localhost:11434

# Database (decided later, see docs/decisions.md)
DATABASE_URL=replace-me
