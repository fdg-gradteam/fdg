# Store text files with LF line endings in the repo, whatever OS edits them.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.ttf binary
